<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.subjex</groupId>
    <artifactId>subjex</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>subjex</name>
    <description>Subjex platform skeleton / Subjex 平台骨架</description>

    <modules>
        <module>platform-contract</module>
        <module>platform-app</module>
        <module>sample-consumer</module>
        <module>model-gateway</module>
        <module>form-render</module>
        <module>page-language</module>
        <module>page-skin</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <archunit.version>1.4.1</archunit.version>
        <opentelemetry.version>1.66.0</opentelemetry.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.subjex</groupId>
                <artifactId>platform-contract</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.subjex</groupId>
                <artifactId>platform-app</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.subjex</groupId>
                <artifactId>form-render</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.subjex</groupId>
                <artifactId>page-language</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.subjex</groupId>
                <artifactId>page-skin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-api</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-sdk</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-sdk-trace</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
