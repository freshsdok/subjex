<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <groupId>com.subjex</groupId>
    <artifactId>subjex</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>subjex</name>
    <description>Subjex platform skeleton / Subjex 平台骨架</description>

    <modules>
        <module>platform-contract</module>
        <module>platform-app</module>
        <module>sample-consumer</module>
        <module>model-gateway</module>
        <module>subjex-outbox-kafka</module>
        <module>form-render</module>
        <module>entity-declare</module>
        <module>page-declare</module>
        <module>page-language</module>
        <module>page-skin</module>
        <module>entry-gateway</module>
        <module>tools/subjex-init</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <archunit.version>1.4.1</archunit.version>
        <opentelemetry.version>1.66.0</opentelemetry.version>
        <!-- Boot4-2 Trivy: Tomcat ≥11.0.25, Jackson 3 BOM ≥3.1.7, leftover Jackson 2 → 2.21.7.
             Boot4-2 镜像扫描：Tomcat / Jackson 3 BOM / 残留 Jackson 2 版本覆盖。 -->
        <tomcat.version>11.0.26</tomcat.version>
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
        <!-- postgresql slightly ahead of Boot BOM 42.7.13 / 略高于 Boot BOM。 -->
        <postgresql.version>42.7.14</postgresql.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.subjex</groupId>
                <artifactId>platform-contract</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.subjex</groupId>
                <artifactId>platform-app</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.subjex</groupId>
                <artifactId>subjex-outbox-kafka</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.subjex</groupId>
                <artifactId>form-render</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.subjex</groupId>
                <artifactId>entity-declare</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.subjex</groupId>
                <artifactId>page-declare</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.subjex</groupId>
                <artifactId>page-language</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.subjex</groupId>
                <artifactId>page-skin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.subjex</groupId>
                <artifactId>entry-gateway</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-api</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-sdk</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-sdk-trace</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-exporter-otlp</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
