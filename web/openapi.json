    "components": {
        "schemas": {
            "ConfigValueDocument": {
                "type": "object",
                "properties": {
                    "value": {
                        "type": "string"
                    }
                }
            },
            "ConfigEntryDocument": {
                "type": "object",
                "properties": {
                    "key": {
                        "type": "string"
                    },
                    "value": {
                        "type": "string"
                    },
                    "origin": {
                        "type": "string"
                    }
                }
            },
            "SkinDocument": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "variables": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        }
                    }
                }
            },
            "SkinListDocument": {
                "type": "object",
                "properties": {
                    "skins": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/SkinDocument"
                        }
                    }
                }
            },
            "ServiceDocument": {
                "type": "object",
                "properties": {
                    "serviceName": {
                        "type": "string"
                    },
                    "host": {
                        "type": "string"
                    },
                    "port": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "status": {
                        "type": "string"
                    }
                }
            },
            "ServiceListDocument": {
                "type": "object",
                "properties": {
                    "services": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ServiceDocument"
                        }
                    }
                }
            },
            "OperatorSelfDocument": {
                "type": "object",
                "properties": {
                    "loginName": {
                        "type": "string"
                    },
                    "identityId": {
                        "type": "string"
                    },
                    "subjectId": {
                        "type": "string"
                    },
                    "permissions": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            },
            "LanguageDocument": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "string"
                    },
                    "phrases": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        }
                    }
                }
            },
            "LanguageListDocument": {
                "type": "object",
                "properties": {
                    "languages": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/LanguageDocument"
                        }
                    }
                }
            },
            "FieldDocument": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "kind": {
                        "type": "string"
                    },
                    "required": {
                        "type": "boolean"
                    }
                }
            },
            "FormsDocument": {
                "type": "object",
                "properties": {
                    "formKey": {
                        "type": "string"
                    },
                    "titleZh": {
                        "type": "string"
                    },
                    "titleEn": {
                        "type": "string"
                    },
                    "fields": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/FieldDocument"
                        }
                    }
                }
            },
            "DeployDocument": {
                "type": "object",
                "properties": {
                    "applied": {
                        "type": "boolean"
                    },
                    "workloads": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/WorkloadDocument"
                        }
                    }
                }
            },
            "WorkloadDocument": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "image": {
                        "type": "string"
                    },
                    "livenessPath": {
                        "type": "string"
                    },
                    "readinessPath": {
                        "type": "string"
                    },
                    "memoryLimit": {
                        "type": "string"
                    }
                }
            },
            "ConfigDocument": {
                "type": "object",
                "properties": {
                    "entries": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ConfigEntryDocument"
                        }
                    }
                }
            },
            "CodegenDocument": {
                "type": "object",
                "properties": {
                    "recordName": {
                        "type": "string"
                    },
                    "components": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ComponentDocument"
                        }
                    }
                }
            },
            "ComponentDocument": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "javaType": {
                        "type": "string"
                    },
                    "typeZh": {
                        "type": "string"
                    }
                }
            },
            "AuditDocument": {
                "type": "object",
                "properties": {
                    "entries": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/AuditEntryDocument"
                        }
                    }
                }
            },
            "AuditEntryDocument": {
                "type": "object",
                "properties": {
                    "auditEntryId": {
                        "type": "string"
                    },
                    "occurredAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "tenantId": {
                        "type": "string"
                    },
                    "actorIdentityId": {
                        "type": "string"
                    },
                    "actorLogin": {
                        "type": "string"
                    },
                    "actor": {
                        "type": "string"
                    },
                    "actionName": {
                        "type": "string"
                    },
                    "actionWordZh": {
                        "type": "string"
                    },
                    "actionWordEn": {
                        "type": "string"
                    },
                    "actionTarget": {
                        "type": "string"
                    },
                    "outcome": {
                        "type": "string"
                    },
                    "outcomeWordZh": {
                        "type": "string"
                    },
                    "outcomeWordEn": {
                        "type": "string"
                    }
                }
            }
        },
        "securitySchemes": {
