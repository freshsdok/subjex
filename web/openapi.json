      "put": {
        "tags": [
          "config-api-endpoint"
        ],
        "operationId": "override",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigValueDocument"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigEntryDocument"
                }
              }
            }
          },
          "401": {
            "description": "No operator signed in — 没有已登录的操作员"
          },
          "403": {
            "description": "Operator lacks the permission — 操作员缺少这项权限"
          }
        }
      }
    },
