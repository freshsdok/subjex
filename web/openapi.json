            "put": {
                "tags": [
                    "config-api-endpoint"
                ],
                "operationId": "override",
                "parameters": [
                    {
                        "name": "key",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ConfigValueDocument"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ConfigEntryDocument"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No operator signed in \u2014 \u6ca1\u6709\u5df2\u767b\u5f55\u7684\u64cd\u4f5c\u5458"
                    },
                    "403": {
                        "description": "Operator lacks the permission \u2014 \u64cd\u4f5c\u5458\u7f3a\u5c11\u8fd9\u9879\u6743\u9650"
                    }
                }
            }
        },
